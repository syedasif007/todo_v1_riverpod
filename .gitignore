# ============================================================================
# Machine-local / generated files (regenerated on `flutter pub get`)
# ============================================================================
#
# These are rewritten per-developer machine by the Flutter tooling. They
# contain absolute paths (e.g. /Users/<you>/.../flutter) or auto-generated
# plugin registrations, so committing them only causes merge churn.
#
# Do NOT add `Runner.xcodeproj/project.pbxproj` /
# `Runner.xcworkspace/contents.xcworkspacedata` here — those are the actual
# Xcode project files and are required for the project to build on other
# machines. They are rewritten by Xcode when a plugin is added, and that
# change should be committed normally.

# Per-machine Flutter SDK path baked in by `flutter pub get`.
ios/Flutter/Debug.xcconfig
ios/Flutter/Release.xcconfig
ios/Flutter/Generated.xcconfig
macos/Flutter/Flutter-Debug.xcconfig
macos/Flutter/Flutter-Release.xcconfig
macos/Flutter/Generated.xcconfig

# Auto-generated plugin registrations (rewritten on every `flutter pub get`).
linux/flutter/generated_plugin_registrant.cc
linux/flutter/generated_plugin_registrant.h
linux/flutter/generated_plugins.cmake
windows/flutter/generated_plugin_registrant.cc
windows/flutter/generated_plugin_registrant.h
windows/flutter/generated_plugins.cmake
macos/Flutter/GeneratedPluginRegistrant.swift

# CocoaPods artifacts (regenerated by `flutter pub get` / `pod install`).
ios/Podfile
ios/Podfile.lock
macos/Podfile
macos/Podfile.lock
